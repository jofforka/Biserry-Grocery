rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email != null && request.auth.token.email == 'admin@biserry.com'; }
    function ownCustomer(uid) { return signedIn() && request.auth.uid == uid; }
    function dispatcherOwns(dispatcherId) {
      return signedIn()
        && exists(/databases/$(database)/documents/dispatchers/$(dispatcherId))
        && get(/databases/$(database)/documents/dispatchers/$(dispatcherId)).data.authUid == request.auth.uid;
    }
    function dispatcherIsPublic(dispatcherId) {
      return exists(/databases/$(database)/documents/dispatchers/$(dispatcherId))
        && get(/databases/$(database)/documents/dispatchers/$(dispatcherId)).data.isPublic == true
        && get(/databases/$(database)/documents/dispatchers/$(dispatcherId)).data.isApproved == true
        && get(/databases/$(database)/documents/dispatchers/$(dispatcherId)).data.isActive == true
        && get(/databases/$(database)/documents/dispatchers/$(dispatcherId)).data.isAvailable == true;
    }
    function validOrderRequester(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId))
        && ((signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid)
            || get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == null);
    }
    function isAssignedDispatcherForRequest() {
      return signedIn() && resource.data.dispatcherId != null && dispatcherOwns(resource.data.dispatcherId);
    }
    function isDispatcherForOrder(orderId) {
      return signedIn()
        && exists(/databases/$(database)/documents/dispatchRequests/$(orderId))
        && get(/databases/$(database)/documents/dispatchRequests/$(orderId)).data.status != 'Offered'
        && get(/databases/$(database)/documents/dispatchRequests/$(orderId)).data.status != 'Declined'
        && get(/databases/$(database)/documents/dispatchRequests/$(orderId)).data.status != 'Cancelled'
        && dispatcherOwns(get(/databases/$(database)/documents/dispatchRequests/$(orderId)).data.dispatcherId);
    }
    function validRiderStatusTransition(oldStatus, newStatus) {
      return (oldStatus == 'Offered' && (newStatus == 'Accepted' || newStatus == 'Declined'))
        || (oldStatus == 'Accepted' && newStatus == 'Picked Up')
        || (oldStatus == 'Picked Up' && newStatus == 'On the Way')
        || (oldStatus == 'On the Way' && newStatus == 'Arrived')
        || (oldStatus == 'Arrived' && newStatus == 'Delivered');
    }
    function validStandaloneTransition(oldStatus, newStatus) {
      return (oldStatus == 'Assigned' && (newStatus == 'Accepted' || newStatus == 'Declined'))
        || (oldStatus == 'Accepted' && newStatus == 'Picked Up')
        || (oldStatus == 'Picked Up' && newStatus == 'On the Way')
        || (oldStatus == 'On the Way' && newStatus == 'Arrived')
        || (oldStatus == 'Arrived' && newStatus == 'Delivered');
    }
    function validDeliveryZoneForNewOrder() {
      return request.resource.data.fulfillment != 'Delivery'
        || (
          request.resource.data.deliveryZoneId != null
          && exists(/databases/$(database)/documents/delivery_zones/$(request.resource.data.deliveryZoneId))
          && get(/databases/$(database)/documents/delivery_zones/$(request.resource.data.deliveryZoneId)).data.isActive == true
          && request.resource.data.deliveryFee == get(/databases/$(database)/documents/delivery_zones/$(request.resource.data.deliveryZoneId)).data.fee
          && request.resource.data.commissionPercent == get(/databases/$(database)/documents/delivery_zones/$(request.resource.data.deliveryZoneId)).data.commissionPercent
          && request.resource.data.biserryCommission == get(/databases/$(database)/documents/delivery_zones/$(request.resource.data.deliveryZoneId)).data.biserryCommission
          && request.resource.data.riderEarning == get(/databases/$(database)/documents/delivery_zones/$(request.resource.data.deliveryZoneId)).data.riderEarning
        );
    }

    match /products/{productId} {
      allow get, list: if isAdmin() || resource.data.isActive == true;
      allow create, update, delete: if isAdmin();
    }
    match /customers/{uid} {
      allow read, create, update: if isAdmin() || ownCustomer(uid);
      allow delete: if isAdmin();
    }
    match /orders/{orderId} {
      allow create: if (
          !request.resource.data.keys().hasAny(['customerUid'])
          || request.resource.data.customerUid == null
          || (signedIn() && request.resource.data.customerUid == request.auth.uid)
        )
        && request.resource.data.paymentMethod == 'Bank Transfer'
        && request.resource.data.paymentStatus == 'Unpaid'
        && request.resource.data.deliveryReleaseStatus == 'Locked'
        && validDeliveryZoneForNewOrder();
      allow read: if isAdmin()
                  || (signedIn() && resource.data.customerUid == request.auth.uid)
                  || isDispatcherForOrder(orderId);
      allow update: if isAdmin()
                    || (isDispatcherForOrder(orderId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'orderStatus','dispatchStatus','assignedDispatcherId','assignedDispatcherName','updatedAt'
                        ])
                        && (request.resource.data.orderStatus != 'Delivered'
                            || (resource.data.paymentStatus == 'Paid' && resource.data.deliveryReleaseStatus == 'Authorized')));
      allow delete: if isAdmin();
    }
    match /orderTracking/{orderId} {
      allow get: if true;
      allow list: if false;
      allow create: if exists(/databases/$(database)/documents/orders/$(orderId))
                    && request.resource.data.keys().hasOnly([
                      'orderStatus','paymentStatus','deliveryReleaseStatus','dispatchStatus','fulfillment','total',
                      'deliveryZoneId','deliveryZone','deliveryFee','commissionPercent','biserryCommission','riderEarning',
                      'createdAt','updatedAt'
                    ])
                    && request.resource.data.paymentStatus == 'Unpaid'
                    && request.resource.data.deliveryReleaseStatus == 'Locked';
      allow update: if isAdmin()
                    || (
                      validOrderRequester(orderId)
                      && exists(/databases/$(database)/documents/paymentProofs/$(orderId))
                      && get(/databases/$(database)/documents/paymentProofs/$(orderId)).data.status == 'Awaiting Verification'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus','deliveryReleaseStatus','updatedAt'])
                      && request.resource.data.paymentStatus == 'Awaiting Verification'
                      && request.resource.data.deliveryReleaseStatus == 'Locked'
                    )
                    || (
                      exists(/databases/$(database)/documents/dispatchRequests/$(orderId))
                      && validOrderRequester(orderId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dispatchRequestId','dispatchStatus','updatedAt'])
                    )
                    || (
                      isDispatcherForOrder(orderId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus','dispatchStatus','dispatcherName','updatedAt'])
                      && (request.resource.data.orderStatus != 'Delivered'
                          || (resource.data.paymentStatus == 'Paid' && resource.data.deliveryReleaseStatus == 'Authorized'))
                    );
      allow delete: if isAdmin();
    }
    match /paymentProofs/{orderId} {
      allow get: if isAdmin() || validOrderRequester(orderId);
      allow list: if isAdmin();
      allow create: if validOrderRequester(orderId)
                    && request.resource.data.orderId == orderId
                    && request.resource.data.amount == get(/databases/$(database)/documents/orders/$(orderId)).data.total
                    && request.resource.data.status == 'Awaiting Verification'
                    && request.resource.data.keys().hasOnly([
                      'orderId','amount','paymentReference','receiptUrl','status','submittedAt','updatedAt'
                    ]);
      allow update: if isAdmin()
                    || (validOrderRequester(orderId)
                        && resource.data.status != 'Approved'
                        && request.resource.data.status == 'Awaiting Verification'
                        && request.resource.data.orderId == resource.data.orderId
                        && request.resource.data.amount == resource.data.amount
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'paymentReference','receiptUrl','status','submittedAt','updatedAt'
                        ]));
      allow delete: if isAdmin();
    }
    match /dispatchers/{dispatcherId} {
      allow read: if isAdmin() || resource.data.isPublic == true || (signedIn() && resource.data.authUid == request.auth.uid);
      allow create: if isAdmin() || (signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.isApproved == false
        && request.resource.data.isAvailable == false
        && request.resource.data.isPublic == false);
      allow update: if isAdmin() || (signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.isApproved == resource.data.isApproved
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isAvailable','isPublic','lastAvailabilityAt','updatedAt'])
        && request.resource.data.isPublic == (request.resource.data.isAvailable == true && resource.data.isApproved == true && resource.data.isActive == true));
      allow delete: if isAdmin();
    }
    match /dispatchRequests/{orderId} {
      allow create: if request.resource.data.orderId == orderId
                    && validOrderRequester(orderId)
                    && dispatcherIsPublic(request.resource.data.dispatcherId)
                    && request.resource.data.status == 'Offered'
                    && request.resource.data.zoneId == get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryZoneId
                    && request.resource.data.deliveryFee == get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryFee
                    && request.resource.data.commissionPercent == get(/databases/$(database)/documents/orders/$(orderId)).data.commissionPercent
                    && request.resource.data.biserryCommission == get(/databases/$(database)/documents/orders/$(orderId)).data.biserryCommission
                    && request.resource.data.riderEarning == get(/databases/$(database)/documents/orders/$(orderId)).data.riderEarning
                    && request.resource.data.paymentStatus == get(/databases/$(database)/documents/orders/$(orderId)).data.paymentStatus
                    && request.resource.data.deliveryReleaseStatus == get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryReleaseStatus
                    && request.resource.data.earningStatus == 'Pending'
                    && request.resource.data.settlementStatus == 'Pending'
                    && request.resource.data.keys().hasOnly([
                      'orderId','customerUid','dispatcherId','dispatcherName','status','zoneId','zoneName','deliveryFee',
                      'commissionPercent','biserryCommission','riderEarning','paymentStatus','deliveryReleaseStatus',
                      'earningStatus','settlementStatus','createdAt','updatedAt'
                    ]);
      allow read: if isAdmin() || validOrderRequester(orderId) || isAssignedDispatcherForRequest();
      allow update: if isAdmin()
                    || (validOrderRequester(orderId)
                        && (resource.data.status == 'Declined' || resource.data.status == 'Cancelled')
                        && request.resource.data.status == 'Offered'
                        && dispatcherIsPublic(request.resource.data.dispatcherId)
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customerUid','dispatcherId','dispatcherName','status','updatedAt']))
                    || (isAssignedDispatcherForRequest()
                        && request.resource.data.orderId == resource.data.orderId
                        && request.resource.data.dispatcherId == resource.data.dispatcherId
                        && request.resource.data.customerUid == resource.data.customerUid
                        && request.resource.data.deliveryFee == resource.data.deliveryFee
                        && request.resource.data.riderEarning == resource.data.riderEarning
                        && request.resource.data.biserryCommission == resource.data.biserryCommission
                        && request.resource.data.paymentStatus == resource.data.paymentStatus
                        && request.resource.data.deliveryReleaseStatus == resource.data.deliveryReleaseStatus
                        && request.resource.data.settlementStatus == resource.data.settlementStatus
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                          'status','acceptedAt','pickedUpAt','onTheWayAt','arrivedAt','deliveredAt','earningStatus','updatedAt'
                        ])
                        && validRiderStatusTransition(resource.data.status, request.resource.data.status)
                        && (request.resource.data.status != 'Delivered'
                            || (resource.data.paymentStatus == 'Paid'
                                && resource.data.deliveryReleaseStatus == 'Authorized'
                                && request.resource.data.earningStatus == 'Earned')));
      allow delete: if isAdmin();
    }

    match /dispatchBookings/{bookingId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'type','serviceType','pickupAddress','dropoffAddress','zoneId','zoneName',
          'packageSize','pickupWhen','pickupDate','pickupTime','customerName','customerPhone',
          'customerUid','note','estimatedFare','status','paymentStatus','assignedDispatcherId',
          'assignedDispatcherName','confirmedFare','riderEarning','biserryCommission','commissionPercent',
          'createdAt','updatedAt'
        ])
        && request.resource.data.type == 'Standalone Package'
        && request.resource.data.serviceType in ['Standard','Express','Scheduled']
        && request.resource.data.pickupWhen in ['ASAP','Scheduled']
        && request.resource.data.status == 'New'
        && request.resource.data.paymentStatus == 'Not Requested'
        && request.resource.data.assignedDispatcherId == null
        && request.resource.data.confirmedFare == null
        && request.resource.data.riderEarning == null
        && request.resource.data.biserryCommission == null
        && request.resource.data.commissionPercent == null
        && request.resource.data.pickupAddress is string
        && request.resource.data.pickupAddress.size() > 3
        && request.resource.data.pickupAddress.size() <= 300
        && request.resource.data.dropoffAddress is string
        && request.resource.data.dropoffAddress.size() > 3
        && request.resource.data.dropoffAddress.size() <= 300
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 1
        && request.resource.data.customerName.size() <= 120
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.size() >= 7
        && request.resource.data.customerPhone.size() <= 30
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 1000
        && (request.resource.data.customerUid == null
            || (request.auth != null && request.resource.data.customerUid == request.auth.uid));

      allow read: if isAdmin()
                  || (signedIn() && resource.data.customerUid != null && resource.data.customerUid == request.auth.uid)
                  || (resource.data.assignedDispatcherId != null && dispatcherOwns(resource.data.assignedDispatcherId));

      allow update: if isAdmin()
                    || (
                      resource.data.assignedDispatcherId != null
                      && dispatcherOwns(resource.data.assignedDispatcherId)
                      && resource.data.paymentStatus == 'Paid'
                      && request.resource.data.assignedDispatcherId == resource.data.assignedDispatcherId
                      && request.resource.data.customerUid == resource.data.customerUid
                      && request.resource.data.confirmedFare == resource.data.confirmedFare
                      && request.resource.data.riderEarning == resource.data.riderEarning
                      && request.resource.data.biserryCommission == resource.data.biserryCommission
                      && request.resource.data.paymentStatus == resource.data.paymentStatus
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status','acceptedAt','declinedAt','pickedUpAt','onTheWayAt','arrivedAt',
                        'deliveredAt','earningStatus','settlementStatus','updatedAt'
                      ])
                      && validStandaloneTransition(resource.data.status, request.resource.data.status)
                    );
      allow delete: if isAdmin();
    }

    match /dispatchBookingTracking/{bookingId} {
      allow get: if true;
      allow list: if false;
      allow create: if exists(/databases/$(database)/documents/dispatchBookings/$(bookingId))
                    && request.resource.data.bookingId == bookingId
                    && request.resource.data.status == 'New'
                    && request.resource.data.paymentStatus == 'Not Requested'
                    && request.resource.data.keys().hasOnly([
                      'bookingId','status','serviceType','zoneName','pickupWhen','pickupDate','pickupTime',
                      'estimatedFare','confirmedFare','paymentStatus','assignedDispatcherName','createdAt','updatedAt'
                    ]);
      allow update: if isAdmin()
                    || (
                      signedIn()
                      && exists(/databases/$(database)/documents/dispatchBookings/$(bookingId))
                      && get(/databases/$(database)/documents/dispatchBookings/$(bookingId)).data.assignedDispatcherId != null
                      && dispatcherOwns(get(/databases/$(database)/documents/dispatchBookings/$(bookingId)).data.assignedDispatcherId)
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'status','assignedDispatcherName','updatedAt'
                      ])
                    );
      allow delete: if isAdmin();
    }

    match /dispatchPaymentProofs/{bookingId} {
      allow get, list: if isAdmin();
      allow create: if exists(/databases/$(database)/documents/dispatchBookings/$(bookingId))
                    && request.resource.data.bookingId == bookingId
                    && request.resource.data.amount == get(/databases/$(database)/documents/dispatchBookings/$(bookingId)).data.confirmedFare
                    && request.resource.data.status == 'Awaiting Verification'
                    && request.resource.data.keys().hasOnly([
                      'bookingId','amount','paymentReference','receiptUrl','status','submittedAt','updatedAt'
                    ]);
      allow update: if isAdmin()
                    || (
                      resource.data.status != 'Approved'
                      && request.resource.data.bookingId == resource.data.bookingId
                      && request.resource.data.amount == resource.data.amount
                      && request.resource.data.status == 'Awaiting Verification'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                        'paymentReference','receiptUrl','status','submittedAt','updatedAt'
                      ])
                    );
      allow delete: if isAdmin();
    }

    match /delivery_zones/{zoneId} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /farmers_market_requests/{requestId} { allow create: if true; allow read, update, delete: if isAdmin(); }
    match /inventory_logs/{id} { allow read, create, update, delete: if isAdmin(); }
    match /supplierImports/{id} { allow read, create, update, delete: if isAdmin(); }
    match /catalogueExceptions/{id} { allow read, create, update, delete: if isAdmin(); }
    match /catalogueJobs/{id} { allow read, create, update, delete: if isAdmin(); }
    match /catalogueEnrichment/{id} { allow read, create, update, delete: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /app_config/{id} { allow read: if true; allow create, update, delete: if isAdmin(); }
    match /audit_logs/{id} { allow read, create: if isAdmin(); allow update, delete: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
